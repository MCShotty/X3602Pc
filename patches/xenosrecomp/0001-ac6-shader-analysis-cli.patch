+#ifdef _WIN32
+static DWORD recompileShaderSafely(ShaderRecompiler* recompiler,
+    const uint8_t* shaderData, const std::string_view* include) noexcept
+{
+    DWORD exceptionCode = ERROR_SUCCESS;
+    __try
+    {
+        recompiler->recompile(shaderData, *include);
+    }
+    __except ((exceptionCode = GetExceptionCode(), EXCEPTION_EXECUTE_HANDLER))
+    {
+    }
+    return exceptionCode;
+}
+#endif
