+static void storeBigEndian32(std::vector<uint8_t>& data, size_t offset,
+    uint32_t value)
+{
+    data[offset] = uint8_t(value >> 24);
+    data[offset + 1] = uint8_t(value >> 16);
+    data[offset + 2] = uint8_t(value >> 8);
+    data[offset + 3] = uint8_t(value);
+}
+
+static std::vector<uint8_t> buildRawShaderContainer(
+    const uint8_t* ucode, size_t ucodeSize, bool pixelShader)
+{
+    constexpr uint32_t interpolatorCount = 16;
+    constexpr size_t constantTableOffset = sizeof(ShaderContainer);
+    constexpr size_t shaderOffset =
+        constantTableOffset + sizeof(ConstantTableContainer);
+    constexpr size_t shaderMetadataSize =
+        sizeof(Shader) + 2 * sizeof(uint32_t) +
+        interpolatorCount * sizeof(uint32_t);
+    constexpr size_t virtualSize = shaderOffset + shaderMetadataSize;
+
+    static_assert(sizeof(ShaderContainer) == 36);
+    static_assert(sizeof(ConstantTableContainer) == 32);
+    static_assert(sizeof(Shader) == 24);
+
+    std::vector<uint8_t> container(virtualSize + ucodeSize);
+    storeBigEndian32(container, 0, 0x102A1100U | (pixelShader ? 0U : 1U));
+    storeBigEndian32(container, 4, uint32_t(virtualSize));
+    storeBigEndian32(container, 8, uint32_t(ucodeSize));
+    storeBigEndian32(container, 16, uint32_t(constantTableOffset));
+    storeBigEndian32(container, 20, 0);
+    storeBigEndian32(container, 24, uint32_t(shaderOffset));
+
+    storeBigEndian32(container, constantTableOffset,
+        uint32_t(sizeof(ConstantTableContainer)));
+    storeBigEndian32(container, constantTableOffset + 4,
+        uint32_t(sizeof(ConstantTable)));
+
+    storeBigEndian32(container, shaderOffset, 0);
+    storeBigEndian32(container, shaderOffset + 4, uint32_t(ucodeSize));
+    storeBigEndian32(container, shaderOffset + 12,
+        pixelShader ? 0x0000FF00U : 0U);
+    storeBigEndian32(container, shaderOffset + 20,
+        interpolatorCount << 5);
+    storeBigEndian32(container, shaderOffset + 24, 0);
+    storeBigEndian32(container, shaderOffset + 28,
+        pixelShader ? uint32_t(PIXEL_SHADER_OUTPUT_COLOR0 |
+                               PIXEL_SHADER_OUTPUT_COLOR1 |
+                               PIXEL_SHADER_OUTPUT_COLOR2 |
+                               PIXEL_SHADER_OUTPUT_COLOR3 |
+                               PIXEL_SHADER_OUTPUT_DEPTH)
+                    : 0U);
+
+    for (uint32_t i = 0; i < interpolatorCount; ++i)
+    {
+        const uint32_t interpolator =
+            i | (uint32_t(DeclUsage::TexCoord) << 4) | (i << 8);
+        storeBigEndian32(container, shaderOffset + 32 + i * 4,
+            interpolator);
+    }
+
+    memcpy(container.data() + virtualSize, ucode, ucodeSize);
+    return container;
+}
