+static bool GeneratedCodeWritesStackPointer(const std::string_view generatedCode)
+{
+    constexpr std::string_view stackPointerPrefix = "ctx.r1.";
+    size_t lineStart = 0;
+
+    while (lineStart < generatedCode.size())
+    {
+        const auto lineEnd = generatedCode.find('\n', lineStart);
+        auto line = generatedCode.substr(
+            lineStart,
+            lineEnd == std::string_view::npos
+                ? generatedCode.size() - lineStart
+                : lineEnd - lineStart);
+        const auto contentStart = line.find_first_not_of(" \t");
+        if (contentStart != std::string_view::npos)
+        {
+            line.remove_prefix(contentStart);
+            if (line.compare(
+                    0,
+                    stackPointerPrefix.size(),
+                    stackPointerPrefix) == 0)
+            {
+                const auto assignment = line.find('=');
+                if (assignment != std::string_view::npos)
+                {
+                    const auto previous =
+                        assignment == 0 ? '\0' : line[assignment - 1];
+                    const auto next =
+                        assignment + 1 >= line.size()
+                            ? '\0'
+                            : line[assignment + 1];
+                    if (next != '=' &&
+                        previous != '=' &&
+                        previous != '!' &&
+                        previous != '<' &&
+                        previous != '>')
+                    {
+                        return true;
+                    }
+                }
+            }
+        }
+
+        if (lineEnd == std::string_view::npos)
+        {
+            break;
+        }
+        lineStart = lineEnd + 1;
+    }
+
+    return false;
+}
