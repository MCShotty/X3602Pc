diff --git a/XenonUtils/ppc_context.h b/XenonUtils/ppc_context.h
index 31a86cd..d2904a5 100644
--- a/XenonUtils/ppc_context.h
+++ b/XenonUtils/ppc_context.h
@@ -205,6 +205,237 @@ union alignas(0x10) PPCVRegister
     double f64[2];
 };
 
+inline uint64_t PPC_MULHDU(const uint64_t a, const uint64_t b) noexcept
+{
+    constexpr uint64_t mask = UINT32_MAX;
+    const uint64_t a0 = a & mask;
+    const uint64_t a1 = a >> 32;
+    const uint64_t b0 = b & mask;
+    const uint64_t b1 = b >> 32;
+
+    uint64_t t = a0 * b0;
+    const uint64_t carry = t >> 32;
+    t = a1 * b0 + carry;
+    const uint64_t middleLow = t & mask;
+    const uint64_t middleHigh = t >> 32;
+    t = a0 * b1 + middleLow;
+
+    return a1 * b1 + middleHigh + (t >> 32);
+}
+
+inline void PPC_VANDC(
+    PPCVRegister& destination,
+    const PPCVRegister& a,
+    const PPCVRegister& b) noexcept
+{
+    PPCVRegister result{};
+    result.u64[0] = a.u64[0] & ~b.u64[0];
+    result.u64[1] = a.u64[1] & ~b.u64[1];
+    destination = result;
+}
+
+inline void PPC_VSEL(
+    PPCVRegister& destination,
+    const PPCVRegister& a,
+    const PPCVRegister& b,
+    const PPCVRegister& mask) noexcept
+{
+    PPCVRegister result{};
+    result.u64[0] = (a.u64[0] & ~mask.u64[0]) | (b.u64[0] & mask.u64[0]);
+    result.u64[1] = (a.u64[1] & ~mask.u64[1]) | (b.u64[1] & mask.u64[1]);
+    destination = result;
+}
+
+inline void PPC_VCMPBFP(
+    PPCVRegister& destination,
+    const PPCVRegister& a,
+    const PPCVRegister& b,
+    PPCCRRegister* const cr6) noexcept
+{
+    PPCVRegister result{};
+    bool allWithinBounds = true;
+
+    for (size_t i = 0; i < 4; ++i)
+    {
+        uint32_t lane = 0;
+        if (std::isnan(a.f32[i]) || std::isnan(b.f32[i]))
+        {
+            lane = 0xC0000000u;
+        }
+        else
+        {
+            if (a.f32[i] > b.f32[i])
+            {
+                lane |= 0x80000000u;
+            }
+            if (a.f32[i] < -b.f32[i])
+            {
+                lane |= 0x40000000u;
+            }
+        }
+
+        result.u32[i] = lane;
+        allWithinBounds &= lane == 0;
+    }
+
+    destination = result;
+    if (cr6 != nullptr)
+    {
+        cr6->lt = 0;
+        cr6->gt = 0;
+        cr6->eq = allWithinBounds;
+        cr6->so = 0;
+    }
+}
+
+inline void PPC_VPKSWSS(
+    PPCVRegister& destination,
+    const PPCVRegister& a,
+    const PPCVRegister& b,
+    uint32_t& vscr) noexcept
+{
+    PPCVRegister result{};
+    bool saturated = false;
+
+    const auto saturate = [&saturated](const int32_t value) -> int16_t
+    {
+        if (value > INT16_MAX)
+        {
+            saturated = true;
+            return INT16_MAX;
+        }
+        if (value < INT16_MIN)
+        {
+            saturated = true;
+            return INT16_MIN;
+        }
+        return static_cast<int16_t>(value);
+    };
+
+    // XenonRecomp reverses whole vectors on load, so guest VA|VB is host VB|VA.
+    for (size_t i = 0; i < 4; ++i)
+    {
+        result.s16[i] = saturate(b.s32[i]);
+        result.s16[i + 4] = saturate(a.s32[i]);
+    }
+
+    destination = result;
+    if (saturated)
+    {
+        vscr |= 1u;
+    }
+}
+
+inline uint16_t PPC_FLOAT_TO_HALF_TRUNCATE(const float value) noexcept
+{
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof(bits));
+
+    const uint16_t sign = static_cast<uint16_t>((bits >> 16) & 0x8000u);
+    const uint32_t exponent = (bits >> 23) & 0xFFu;
+    const uint32_t mantissa = bits & 0x7FFFFFu;
+
+    if (exponent == 0xFFu)
+    {
+        if (mantissa == 0)
+        {
+            return static_cast<uint16_t>(sign | 0x7C00u);
+        }
+
+        uint16_t payload = static_cast<uint16_t>(mantissa >> 13);
+        payload = static_cast<uint16_t>(payload | 0x0200u);
+        return static_cast<uint16_t>(sign | 0x7C00u | payload);
+    }
+
+    const int32_t unbiasedExponent = static_cast<int32_t>(exponent) - 127;
+    if (unbiasedExponent > 15)
+    {
+        return static_cast<uint16_t>(sign | 0x7BFFu);
+    }
+    if (unbiasedExponent >= -14)
+    {
+        const uint16_t halfExponent = static_cast<uint16_t>(unbiasedExponent + 15);
+        return static_cast<uint16_t>(
+            sign | (halfExponent << 10) | static_cast<uint16_t>(mantissa >> 13));
+    }
+    if (unbiasedExponent < -24 || exponent == 0)
+    {
+        return sign;
+    }
+
+    const uint32_t significand = mantissa | 0x800000u;
+    const uint32_t shift = static_cast<uint32_t>((-14 - unbiasedExponent) + 13);
+    return static_cast<uint16_t>(sign | static_cast<uint16_t>(significand >> shift));
+}
+
+inline float PPC_HALF_TO_FLOAT(const uint16_t value) noexcept
+{
+    const uint32_t sign = static_cast<uint32_t>(value & 0x8000u) << 16;
+    uint32_t exponent = (value >> 10) & 0x1Fu;
+    uint32_t mantissa = value & 0x03FFu;
+    uint32_t bits;
+
+    if (exponent == 0)
+    {
+        if (mantissa == 0)
+        {
+            bits = sign;
+        }
+        else
+        {
+            int32_t unbiasedExponent = -14;
+            while ((mantissa & 0x0400u) == 0)
+            {
+                mantissa <<= 1;
+                --unbiasedExponent;
+            }
+            mantissa &= 0x03FFu;
+            bits = sign |
+                (static_cast<uint32_t>(unbiasedExponent + 127) << 23) |
+                (mantissa << 13);
+        }
+    }
+    else if (exponent == 0x1Fu)
+    {
+        bits = sign | 0x7F800000u | (mantissa << 13);
+    }
+    else
+    {
+        exponent = exponent - 15 + 127;
+        bits = sign | (exponent << 23) | (mantissa << 13);
+    }
+
+    float result;
+    std::memcpy(&result, &bits, sizeof(result));
+    return result;
+}
+
+inline void PPC_VPKD3D_FLOAT16_2(
+    PPCVRegister& destination,
+    const PPCVRegister& source,
+    const uint32_t shift) noexcept
+{
+    PPCVRegister result = destination;
+    const PPCVRegister input = source;
+    result.u32[shift] =
+        (static_cast<uint32_t>(PPC_FLOAT_TO_HALF_TRUNCATE(input.f32[3])) << 16) |
+        PPC_FLOAT_TO_HALF_TRUNCATE(input.f32[2]);
+    destination = result;
+}
+
+inline void PPC_VUPKD3D_FLOAT16_4(
+    PPCVRegister& destination,
+    const PPCVRegister& source) noexcept
+{
+    const PPCVRegister input = source;
+    PPCVRegister result{};
+    for (size_t i = 0; i < 4; ++i)
+    {
+        result.f32[i] = PPC_HALF_TO_FLOAT(input.u16[i + 4]);
+    }
+    destination = result;
+}
+
