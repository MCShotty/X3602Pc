diff --git a/XenonAnalyse/tests/ppc_semantics_tests.cpp b/XenonAnalyse/tests/ppc_semantics_tests.cpp
new file mode 100644
index 0000000..67c1847
--- /dev/null
+++ b/XenonAnalyse/tests/ppc_semantics_tests.cpp
@@ -0,0 +1,255 @@
+#define PPC_CONFIG_H_INCLUDED
+#define PPC_IMAGE_BASE 0x82000000u
+#define PPC_IMAGE_SIZE 0x00AA0000u
+#define PPC_CODE_BASE 0x82000000u
+
+#include <ppc_context.h>
+
+#include <cmath>
+#include <cstdint>
+#include <iostream>
+#include <limits>
+
+namespace
+{
+bool Check(const bool condition, const char* const message)
+{
+    if (!condition)
+    {
+        std::cerr << message << '\n';
+    }
+    return condition;
+}
+
+uint64_t ReferenceMulHigh(const uint64_t a, const uint64_t b)
+{
+#if defined(__SIZEOF_INT128__)
+    return static_cast<uint64_t>(
+        (static_cast<unsigned __int128>(a) * static_cast<unsigned __int128>(b)) >> 64);
+#else
+    return PPC_MULHDU(a, b);
+#endif
+}
+
+bool TestMulHigh()
+{
+    constexpr uint64_t values[] = {
+        0,
+        1,
+        UINT32_MAX,
+        UINT64_C(0x100000000),
+        UINT64_C(0x0123456789ABCDEF),
+        UINT64_C(0xFEDCBA9876543210),
+        UINT64_MAX,
+    };
+
+    for (const uint64_t a : values)
+    {
+        for (const uint64_t b : values)
+        {
+            if (!Check(PPC_MULHDU(a, b) == ReferenceMulHigh(a, b), "mulhdu mismatch"))
+            {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+bool TestVectorLogic()
+{
+    PPCVRegister a{};
+    PPCVRegister b{};
+    PPCVRegister mask{};
+    a.u64[0] = UINT64_C(0xFFFF0000AAAA5555);
+    a.u64[1] = UINT64_C(0x123456789ABCDEF0);
+    b.u64[0] = UINT64_C(0x0F0F0F0F33333333);
+    b.u64[1] = UINT64_C(0xFFFFFFFF00000000);
+    mask.u64[0] = UINT64_C(0x00FF00FFFF0000FF);
+    mask.u64[1] = UINT64_C(0xAAAAAAAA55555555);
+
+    PPCVRegister destination = a;
+    PPC_VANDC(destination, destination, b);
+    if (!Check(destination.u64[0] == (a.u64[0] & ~b.u64[0]) &&
+                   destination.u64[1] == (a.u64[1] & ~b.u64[1]),
+               "vandc mismatch or alias failure"))
+    {
+        return false;
+    }
+
+    destination = mask;
+    PPC_VSEL(destination, a, b, destination);
+    return Check(
+        destination.u64[0] == ((a.u64[0] & ~mask.u64[0]) | (b.u64[0] & mask.u64[0])) &&
+            destination.u64[1] == ((a.u64[1] & ~mask.u64[1]) | (b.u64[1] & mask.u64[1])),
+        "vsel mismatch or mask alias failure");
+}
+
+bool TestCompareBounds()
+{
+    PPCVRegister a{};
+    PPCVRegister b{};
+    a.f32[0] = 0.5f;
+    a.f32[1] = 3.0f;
+    a.f32[2] = -3.0f;
+    a.f32[3] = std::numeric_limits<float>::quiet_NaN();
+    b.f32[0] = 1.0f;
+    b.f32[1] = 2.0f;
+    b.f32[2] = 2.0f;
+    b.f32[3] = 1.0f;
+
+    PPCCRRegister cr6{1, 1, 1, {1}};
+    PPCVRegister destination = a;
+    PPC_VCMPBFP(destination, destination, b, &cr6);
+    if (!Check(
+            destination.u32[0] == 0 &&
+                destination.u32[1] == 0x80000000u &&
+                destination.u32[2] == 0x40000000u &&
+                destination.u32[3] == 0xC0000000u,
+            "vcmpbfp lane result mismatch"))
+    {
+        return false;
+    }
+    if (!Check(cr6.lt == 0 && cr6.gt == 0 && cr6.eq == 0 && cr6.so == 0,
+               "vcmpbfp record result mismatch"))
+    {
+        return false;
+    }
+
+    a.f32[0] = -1.0f;
+    a.f32[1] = 0.0f;
+    a.f32[2] = 1.0f;
+    a.f32[3] = 2.0f;
+    b.f32[0] = 1.0f;
+    b.f32[1] = 1.0f;
+    b.f32[2] = 1.0f;
+    b.f32[3] = 2.0f;
+    PPC_VCMPBFP(destination, a, b, &cr6);
+    return Check(cr6.lt == 0 && cr6.gt == 0 && cr6.eq == 1 && cr6.so == 0,
+                 "vcmpbfp all-within-bounds CR6 mismatch");
+}
+
+bool TestPackSignedWord()
+{
+    PPCVRegister a{};
+    PPCVRegister b{};
+    a.s32[0] = INT16_MIN;
+    a.s32[1] = -1;
+    a.s32[2] = 0;
+    a.s32[3] = INT16_MAX;
+    b.s32[0] = INT32_MIN;
+    b.s32[1] = INT16_MIN - 1;
+    b.s32[2] = INT16_MAX + 1;
+    b.s32[3] = INT32_MAX;
+
+    uint32_t vscr = 0x10;
+    PPCVRegister destination = a;
+    PPC_VPKSWSS(destination, destination, b, vscr);
+    constexpr int16_t expected[] = {
+        INT16_MIN,
+        INT16_MIN,
+        INT16_MAX,
+        INT16_MAX,
+        INT16_MIN,
+        -1,
+        0,
+        INT16_MAX,
+    };
+    for (size_t i = 0; i < 8; ++i)
+    {
+        if (!Check(destination.s16[i] == expected[i], "vpkswss lane or alias mismatch"))
+        {
+            return false;
+        }
+    }
+    if (!Check(vscr == 0x11, "vpkswss did not set sticky VSCR SAT"))
+    {
+        return false;
+    }
+
+    a = {};
+    b = {};
+    vscr = 0x40;
+    PPC_VPKSWSS(destination, a, b, vscr);
+    return Check(vscr == 0x40, "vpkswss changed VSCR without saturation");
+}
+
+bool TestScalarSemantics()
+{
+    const uint16_t guestValue = 0x1234;
+    if (!Check(__builtin_bswap16(guestValue) == 0x3412, "lhbrx byte reversal mismatch"))
+    {
+        return false;
+    }
+
+    const double result = 1.0 / std::sqrt(16.0);
+    return Check(result == 0.25, "frsqrte reciprocal square root mismatch");
+}
+
+bool TestD3DPack()
+{
+    if (!Check(
+            PPC_FLOAT_TO_HALF_TRUNCATE(1.0f) == 0x3C00u &&
+                PPC_FLOAT_TO_HALF_TRUNCATE(-2.0f) == 0xC000u &&
+                PPC_FLOAT_TO_HALF_TRUNCATE(65520.0f) == 0x7BFFu &&
+                PPC_FLOAT_TO_HALF_TRUNCATE(std::numeric_limits<float>::infinity()) == 0x7C00u,
+            "float-to-half conversion mismatch"))
+    {
+        return false;
+    }
+    if (!Check(
+            PPC_HALF_TO_FLOAT(0x3C00u) == 1.0f &&
+                PPC_HALF_TO_FLOAT(0xC000u) == -2.0f &&
+                PPC_HALF_TO_FLOAT(0x0001u) == std::ldexp(1.0f, -24),
+            "half-to-float conversion mismatch"))
+    {
+        return false;
+    }
+
+    PPCVRegister source{};
+    source.f32[0] = 4.0f;
+    source.f32[1] = 3.0f;
+    source.f32[2] = 2.0f;
+    source.f32[3] = 1.0f;
+    PPCVRegister packed{};
+    packed.u32[0] = 0x11111111u;
+    packed.u32[1] = 0x22222222u;
+    packed.u32[2] = 0x33333333u;
+    packed.u32[3] = 0x44444444u;
+    PPC_VPKD3D_FLOAT16_2(packed, source, 3);
+    if (!Check(
+            packed.u32[0] == 0x11111111u &&
+                packed.u32[1] == 0x22222222u &&
+                packed.u32[2] == 0x33333333u &&
+                packed.u32[3] == 0x3C004000u,
+            "vpkd3d float16_2 lane placement mismatch"))
+    {
+        return false;
+    }
+
+    packed.u16[4] = PPC_FLOAT_TO_HALF_TRUNCATE(4.0f);
+    packed.u16[5] = PPC_FLOAT_TO_HALF_TRUNCATE(3.0f);
+    packed.u16[6] = PPC_FLOAT_TO_HALF_TRUNCATE(2.0f);
+    packed.u16[7] = PPC_FLOAT_TO_HALF_TRUNCATE(1.0f);
+    PPCVRegister unpacked = packed;
+    PPC_VUPKD3D_FLOAT16_4(unpacked, unpacked);
+    return Check(
+        unpacked.f32[0] == 4.0f &&
+            unpacked.f32[1] == 3.0f &&
+            unpacked.f32[2] == 2.0f &&
+            unpacked.f32[3] == 1.0f,
+        "vupkd3d float16_4 conversion or alias mismatch");
+}
+}
+
+int main()
+{
+    return TestMulHigh() &&
+                   TestVectorLogic() &&
+                   TestCompareBounds() &&
+                   TestPackSignedWord() &&
+                   TestScalarSemantics() &&
+                   TestD3DPack()
+               ? 0
+               : 1;
+}
