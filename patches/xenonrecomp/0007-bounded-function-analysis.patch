diff --git a/XenonAnalyse/tests/function_tests.cpp b/XenonAnalyse/tests/function_tests.cpp
index 18e1b68..a16dccb 100644
--- a/XenonAnalyse/tests/function_tests.cpp
+++ b/XenonAnalyse/tests/function_tests.cpp
@@ -61,5 +61,50 @@ int main()
         return 1;
     }
 
+    const std::array<std::uint32_t, 2> backwardConditional = {
+        ByteSwap(0x4182FFFCu), // beq base - 4
+        ByteSwap(0x4E800020u), // blr
+    };
+    const auto boundedBackward = Function::Analyze(
+        backwardConditional.data(),
+        sizeof(backwardConditional),
+        base);
+    if (!Check(
+            boundedBackward.size == sizeof(backwardConditional),
+            "out-of-range backward conditional branch escaped the buffer"))
+    {
+        return 1;
+    }
+
+    const std::array<std::uint32_t, 2> forwardConditional = {
+        ByteSwap(0x41820010u), // beq base + 0x10
+        ByteSwap(0x4E800020u), // blr
+    };
+    const auto boundedForward = Function::Analyze(
+        forwardConditional.data(),
+        sizeof(forwardConditional),
+        base);
+    if (!Check(
+            boundedForward.size == sizeof(forwardConditional),
+            "out-of-range forward conditional branch escaped the buffer"))
+    {
+        return 1;
+    }
+
+    const std::array<std::uint32_t, 2> forwardTail = {
+        ByteSwap(0x48000010u), // b base + 0x10
+        ByteSwap(0x4E800020u), // unreachable
+    };
+    const auto boundedTail = Function::Analyze(
+        forwardTail.data(),
+        sizeof(forwardTail),
+        base);
+    if (!Check(
+            boundedTail.size == sizeof(std::uint32_t),
+            "out-of-range direct branch was not treated as a tail transfer"))
+    {
+        return 1;
+    }
+
     return 0;
 }
