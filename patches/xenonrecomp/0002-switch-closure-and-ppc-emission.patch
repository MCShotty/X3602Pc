+    // Direct tail branches and cross-fragment conditional branches can target
+    // an address inside another unwind range. Emit an entry point at every
+    // external target so recompilation never silently drops the transfer.
+    for (size_t functionIndex = 0; functionIndex < functions.size(); ++functionIndex)
+    {
+        const auto fn = functions[functionIndex];
+        for (size_t address = fn.base; address < fn.base + fn.size; address += 4)
+        {
+            if (!fn.blocks.empty() &&
+                fn.SearchBlock(address) == static_cast<size_t>(-1))
+            {
+                continue;
+            }
+
+            const auto instruction =
+                ByteSwap(*static_cast<const uint32_t*>(image.Find(address)));
+            if (PPC_BL(instruction))
+            {
+                continue;
+            }
+
+            std::vector<size_t> targets;
+            const auto op = PPC_OP(instruction);
+            if (op == PPC_OP_B)
+            {
+                targets.emplace_back(address + PPC_BI(instruction));
+            }
+            else if (op == PPC_OP_BC)
+            {
+                targets.emplace_back(address + PPC_BD(instruction));
+            }
+            else if (op == PPC_OP_CTR && PPC_XOP(instruction) == 528)
+            {
+                const auto indirectTargets = indirectBranchTargets.find(address);
+                if (indirectTargets != indirectBranchTargets.end())
+                {
+                    targets = indirectTargets->second;
+                }
+            }
+            else
+            {
+                continue;
+            }
+
+            for (const auto target : targets)
+            {
+                const bool targetIsInternal = fn.blocks.empty()
+                    ? target >= fn.base && target < fn.base + fn.size
+                    : fn.SearchBlock(target) != static_cast<size_t>(-1);
+                if (targetIsInternal)
+                {
+                    continue;
+                }
+
+                const auto existingTarget = image.symbols.find(target);
+                if (existingTarget != image.symbols.end() &&
+                    existingTarget->address == target &&
+                    existingTarget->type == Symbol_Function)
+                {
+                    continue;
+                }
+
+                const auto targetSection = std::find_if(
+                    image.sections.begin(),
+                    image.sections.end(),
+                    [target](const Section& candidate)
+                    {
+                        return (candidate.flags & SectionFlags_Code) &&
+                            target >= candidate.base &&
+                            target < candidate.base + candidate.size;
+                    });
+                if (targetSection == image.sections.end())
+                {
+                    fmt::println(
+                        "ERROR: External branch target {:X} is outside executable sections",
+                        target);
+                    continue;
+                }
+
+                auto targetFunction = Function::Analyze(
+                    image.Find(target),
+                    targetSection->base + targetSection->size - target,
+                    target,
+                    &indirectBranchTargets);
+                if (targetFunction.size == 0)
+                {
+                    fmt::println(
+                        "ERROR: External branch target {:X} produced an empty function",
+                        target);
+                    continue;
+                }
+
+                functions.emplace_back(std::move(targetFunction));
+                image.symbols.emplace(
+                    fmt::format("sub_{:X}", target),
+                    target,
+                    functions.back().size,
+                    Symbol_Function);
+            }
+        }
+    }
