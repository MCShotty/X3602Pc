+static std::string_view TrimGeneratedLine(std::string_view line)
+{
+    const auto contentStart = line.find_first_not_of(" \t");
+    if (contentStart == std::string_view::npos)
+    {
+        return {};
+    }
+    line.remove_prefix(contentStart);
+    return line;
+}
 
+static bool FindIndexedRegister(
+    const std::string_view line,
+    const std::string_view prefix,
+    const size_t count,
+    size_t& index)
+{
+    auto position = line.find(prefix);
+    while (position != std::string_view::npos)
+    {
+        auto cursor = position + prefix.size();
+        size_t value = 0;
+        const auto digitStart = cursor;
+        while (cursor < line.size() &&
+               line[cursor] >= '0' &&
+               line[cursor] <= '9')
+        {
+            value = value * 10 + static_cast<size_t>(line[cursor] - '0');
+            ++cursor;
+        }
+        if (cursor != digitStart && value < count)
+        {
+            index = value;
+            return true;
+        }
+        position = line.find(prefix, position + prefix.size());
+    }
+    return false;
+}
+
+static bool ParseIndexedRegisterAtStart(
+    const std::string_view line,
+    const std::string_view prefix,
+    const size_t count,
+    size_t& index)
+{
+    if (line.compare(0, prefix.size(), prefix) != 0)
+    {
+        return false;
+    }
+
+    auto cursor = prefix.size();
+    size_t value = 0;
+    const auto digitStart = cursor;
+    while (cursor < line.size() &&
+           line[cursor] >= '0' &&
+           line[cursor] <= '9')
+    {
+        value = value * 10 + static_cast<size_t>(line[cursor] - '0');
+        ++cursor;
+    }
+    if (cursor == digitStart || value >= count)
+    {
+        return false;
+    }
+
+    index = value;
+    return true;
+}
+
+static void CollectGeneratedStateWrites(
+    const std::string_view line,
+    GeneratedStateWrites& writes)
+{
+    const auto trimmed = TrimGeneratedLine(line);
+    size_t index = 0;
+
+    if (ParseIndexedRegisterAtStart(
+            trimmed,
+            "ctx.r",
+            writes.gpr.size(),
+            index))
+    {
+        writes.gpr[index] = true;
+    }
+    if (ParseIndexedRegisterAtStart(
+            trimmed,
+            "ctx.f",
+            writes.fpr.size(),
+            index))
+    {
+        writes.fpr[index] = true;
+    }
+    if (ParseIndexedRegisterAtStart(
+            trimmed,
+            "ctx.v",
+            writes.vector.size(),
+            index))
+    {
+        writes.vector[index] = true;
+    }
+    if (ParseIndexedRegisterAtStart(
+            trimmed,
+            "ctx.cr",
+            writes.condition.size(),
+            index))
+    {
+        writes.condition[index] = true;
+    }
+
+    const auto firstArgumentEnd = trimmed.find(',');
+    const auto firstArgument = trimmed.substr(0, firstArgumentEnd);
+    if ((trimmed.compare(0, 15, "simde_mm_store_") == 0 ||
+         trimmed.compare(0, 5, "PPC_V") == 0) &&
+        FindIndexedRegister(
+            firstArgument,
+            "ctx.v",
+            writes.vector.size(),
+            index))
+    {
+        writes.vector[index] = true;
+    }
+    if (trimmed.compare(0, 5, "PPC_V") == 0 &&
+        FindIndexedRegister(
+            trimmed,
+            "&ctx.cr",
+            writes.condition.size(),
+            index))
+    {
+        writes.condition[index] = true;
+    }
+    if (trimmed.compare(0, 9, "PPC_VPKSW") == 0 &&
+        trimmed.find("ctx.vscr") != std::string_view::npos)
+    {
+        writes.vscr = true;
+    }
+
+    writes.lr =
+        writes.lr ||
+        trimmed.compare(0, 6, "ctx.lr") == 0;
+    writes.ctr =
+        writes.ctr ||
+        trimmed.compare(0, 7, "ctx.ctr") == 0 ||
+        trimmed.compare(0, 9, "--ctx.ctr") == 0;
+    writes.xer =
+        writes.xer ||
+        trimmed.compare(0, 7, "ctx.xer") == 0;
+    writes.fpscr =
+        writes.fpscr ||
+        trimmed.compare(0, 9, "ctx.fpscr") == 0;
+    writes.vscr =
+        writes.vscr ||
+        trimmed.compare(0, 8, "ctx.vscr") == 0;
+    writes.msr =
+        writes.msr ||
+        trimmed.compare(0, 7, "ctx.msr") == 0;
+}
+
+static bool IsGeneratedStateBoundary(const std::string_view line)
+{
+    const auto trimmed = TrimGeneratedLine(line);
+    return
+        trimmed.compare(0, 2, "if") == 0 ||
+        trimmed.compare(0, 4, "goto") == 0 ||
+        trimmed.compare(0, 6, "return") == 0 ||
+        trimmed.find("(ctx, base)") != std::string_view::npos ||
+        trimmed.find("PPC_CALL_") != std::string_view::npos ||
+        trimmed.find("PPC_LOAD_") != std::string_view::npos ||
+        trimmed.find("PPC_STORE_") != std::string_view::npos ||
+        trimmed.find("PPC_MM_") != std::string_view::npos ||
+        trimmed.find("PPC_READ_TIME_BASE") != std::string_view::npos;
+}
+
+static void FlushGeneratedStateWrites(
+    std::string& output,
+    GeneratedStateWrites& writes)
+{
+    for (size_t index = 0; index < writes.gpr.size(); ++index)
+    {
+        if (writes.gpr[index])
+            fmt::format_to(
+                std::back_inserter(output),
+                "\tPPC_PUBLISH_GPR({});\n",
+                index);
+    }
+    for (size_t index = 0; index < writes.fpr.size(); ++index)
+    {
+        if (writes.fpr[index])
+            fmt::format_to(
+                std::back_inserter(output),
+                "\tPPC_PUBLISH_FPR({});\n",
+                index);
+    }
+    for (size_t index = 0; index < writes.vector.size(); ++index)
+    {
+        if (writes.vector[index])
+            fmt::format_to(
+                std::back_inserter(output),
+                "\tPPC_PUBLISH_VECTOR({});\n",
+                index);
+    }
+    for (size_t index = 0; index < writes.condition.size(); ++index)
+    {
+        if (writes.condition[index])
+            fmt::format_to(
+                std::back_inserter(output),
+                "\tPPC_PUBLISH_CR({});\n",
+                index);
+    }
+    if (writes.lr)
+        output += "\tPPC_PUBLISH_LR();\n";
+    if (writes.ctr)
+        output += "\tPPC_PUBLISH_CTR();\n";
+    if (writes.xer)
+        output += "\tPPC_PUBLISH_XER();\n";
+    if (writes.fpscr)
+        output += "\tPPC_PUBLISH_FPSCR();\n";
+    if (writes.vscr)
+        output += "\tPPC_PUBLISH_VSCR();\n";
+    if (writes.msr)
+        output += "\tPPC_PUBLISH_MSR();\n";
+    writes = GeneratedStateWrites{};
+}
