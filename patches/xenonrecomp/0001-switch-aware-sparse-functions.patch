diff --git a/XenonAnalyse/tests/function_tests.cpp b/XenonAnalyse/tests/function_tests.cpp
new file mode 100644
index 0000000..18e1b68
--- /dev/null
+++ b/XenonAnalyse/tests/function_tests.cpp
@@ -0,0 +1,65 @@
+#include <byteswap.h>
+#include <function.h>
+
+#include <array>
+#include <cstdint>
+#include <iostream>
+
+namespace
+{
+bool Check(const bool condition, const char* message)
+{
+    if (!condition)
+    {
+        std::cerr << message << '\n';
+    }
+    return condition;
+}
+}
+
+int main()
+{
+    constexpr std::size_t base = 0x1000;
+    std::array<std::uint32_t, 8> code = {
+        ByteSwap(0x60000000u), // nop
+        ByteSwap(0x4E800420u), // bctr
+        ByteSwap(0xDEADBEEFu), // inline jump-table data
+        ByteSwap(0xCAFEBABEu), // inline jump-table data
+        ByteSwap(0x38630001u), // addi r3, r3, 1
+        ByteSwap(0x4E800020u), // blr
+        ByteSwap(0x38630002u), // addi r3, r3, 2
+        ByteSwap(0x4E800020u), // blr
+    };
+
+    const auto withoutTargets = Function::Analyze(code.data(), sizeof(code), base);
+    if (!Check(withoutTargets.size == 0x8, "bctr should terminate an unseeded function"))
+    {
+        return 1;
+    }
+
+    Function::IndirectBranchTargets targets = {
+        { base + 0x4, { base + 0x10, base + 0x18, base + 0x10, base + 0x100 } },
+    };
+    const auto withTargets = Function::Analyze(code.data(), sizeof(code), base, &targets);
+    if (!Check(withTargets.size == sizeof(code), "switch targets should extend the function"))
+    {
+        return 1;
+    }
+    if (!Check(withTargets.SearchBlock(base + 0x8) == static_cast<std::size_t>(-1),
+               "inline jump-table data should remain outside analyzed blocks"))
+    {
+        return 1;
+    }
+    if (!Check(withTargets.SearchBlock(base + 0x10) != static_cast<std::size_t>(-1),
+               "first switch case was not analyzed"))
+    {
+        return 1;
+    }
+    if (!Check(withTargets.SearchBlock(base + 0x18) != static_cast<std::size_t>(-1),
+               "second switch case was not analyzed"))
+    {
+        return 1;
+    }
+
+    return 0;
+}
